# Pooled connection string (Neon: the "-pooler" host)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection, used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Protects the scheduled sync endpoint. Vercel sends it automatically to cron jobs.
CRON_SECRET=""
# Used by the seed to create/update your admin login
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="at-least-10-characters"
ADMIN_NAME="Sanuj"
